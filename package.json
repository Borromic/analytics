{
  "name": "@borromic/analytics",
  "version": "0.1.0",
  "description": "Privacy-friendly web analytics for any site: page views, custom events and web vitals, with no cookies.",
  "keywords": [
    "analytics",
    "web-analytics",
    "privacy",
    "cookieless",
    "page-views",
    "events",
    "web-vitals",
    "nextjs",
    "react"
  ],
  "license": "MIT",
  "author": "Borromic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borromic/analytics.git"
  },
  "homepage": "https://github.com/Borromic/analytics#readme",
  "bugs": {
    "url": "https://github.com/Borromic/analytics/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./vitals": {
      "types": "./dist/vitals.d.ts",
      "default": "./dist/vitals.js"
    },
    "./opt-out": {
      "types": "./dist/opt-out.d.ts",
      "default": "./dist/opt-out.js"
    },
    "./script.js": "./dist/script.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-script.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
